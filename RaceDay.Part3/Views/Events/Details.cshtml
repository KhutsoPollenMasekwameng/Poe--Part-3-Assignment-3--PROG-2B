@model JsonElement
@{ ViewData["Title"] = "Event details"; string Read(string key) => Model.ValueKind == JsonValueKind.Object && Model.TryGetProperty(key, out var v) ? v.ToString() : "Not provided"; }
<section class="page-banner"><div class="container py-5"><span class="eyebrow">EVENT DETAILS</span><h1 class="display-5 fw-bold mt-2">@Read("eventName")</h1><p class="text-white-50 mb-0">Review the event information before planning your entry.</p></div></section>
<div class="container py-5"><div class="row g-4"><div class="col-lg-8"><div class="content-panel"><h2 class="h4 fw-bold">About this event</h2><p>@Read("description")</p><hr /><dl class="detail-grid"><dt>Date</dt><dd>@Read("eventDate")</dd><dt>Start time</dt><dd>@Read("startTime")</dd><dt>Location</dt><dd>@Read("location"), @Read("province")</dd><dt>Status</dt><dd><span class="status-pill">@Read("status")</span></dd></dl></div></div><div class="col-lg-4"><aside class="content-panel"><span class="eyebrow dark-eyebrow">ENTRY INFORMATION</span><div class="fee-number mt-2">@Read("entryFee")</div><p class="text-secondary">Entry fee shown by the API</p><div class="detail-line"><span>Maximum participants</span><strong>@Read("maxParticipants")</strong></div><p class="small text-secondary mt-3">Enrolment actions will be connected after confirming the API's enrolment request and response formats.</p><a class="btn btn-dark w-100" asp-action="Index">Back to events</a></aside></div></div></div>
