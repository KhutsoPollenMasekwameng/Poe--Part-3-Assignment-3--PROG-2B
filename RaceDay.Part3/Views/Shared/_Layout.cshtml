<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg navbar-dark raced-navbar">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index"><span class="brand-mark">R</span> RaceDay</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="Index">Events</a></li>
                    @if (Context.Session.GetString("UserRole") == "Organiser") { <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Organiser dashboard</a></li> }
                    @if (Context.Session.GetString("UserRole") == "Participant") { <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">My RaceDay</a></li> }
                </ul>
                <div class="d-flex align-items-center gap-2">
                    @if (!string.IsNullOrWhiteSpace(Context.Session.GetString("UserName"))) {
                        <span class="text-white-50 small d-none d-md-inline">Hi, @Context.Session.GetString("UserName")</span>
                        <form asp-controller="Auth" asp-action="Logout" method="post"><button class="btn btn-outline-light btn-sm" type="submit">Sign out</button></form>
                    } else {
                        <a class="btn btn-outline-light btn-sm" asp-controller="Auth" asp-action="Login">Sign in</a>
                        <a class="btn btn-raceday btn-sm" asp-controller="Auth" asp-action="Register">Join RaceDay</a>
                    }
                </div>
            </div>
        </div>
    </nav>
</header>
<main role="main">
    <div class="container pt-3">
        @if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
        @if (TempData["Error"] is string error) { <div class="alert alert-warning" role="alert">@error</div> }
    </div>
    @RenderBody()
</main>
<footer class="footer mt-5"><div class="container py-4 d-flex flex-wrap justify-content-between gap-2"><span>© @DateTime.Now.Year RaceDay</span><span>Run your race. Own your day.</span></div></footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
