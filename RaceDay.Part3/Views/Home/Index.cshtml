@model JsonElement[]
@{
    ViewData["Title"] = "Discover events";
    string Read(JsonElement e, string key) => e.ValueKind == JsonValueKind.Object && e.TryGetProperty(key, out var v) ? v.ToString() : "";
}
<section class="hero-section">
    <div class="container py-5 py-lg-6">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <span class="eyebrow">YOUR NEXT FINISH LINE STARTS HERE</span>
                <h1 class="display-4 fw-bold mt-3">Find your pace.<br /><span class="text-lime">Make it race day.</span></h1>
                <p class="lead text-white-50 mt-3">Discover races, manage your entries and keep every result in one place.</p>
                <div class="d-flex flex-wrap gap-2 mt-4"><a class="btn btn-raceday btn-lg" asp-controller="Events" asp-action="Index">Explore events <span aria-hidden="true">→</span></a><a class="btn btn-outline-light btn-lg" asp-controller="Auth" asp-action="Register">Create an account</a></div>
            </div>
            <div class="col-lg-5"><div class="hero-stat-card"><div class="stat-label">THE RACE DAY MINDSET</div><div class="stat-number">READY.</div><div class="stat-number text-lime">SET.</div><div class="stat-number">GO.</div><div class="progress mt-4" role="progressbar" aria-label="RaceDay motivation" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" style="width:100%"></div></div><p class="mb-0 mt-3 text-white-50">Every finish starts with showing up.</p></div></div>
        </div>
    </div>
</section>
<section class="container py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><span class="eyebrow dark-eyebrow">ON THE START LINE</span><h2 class="section-title mt-2">Discover upcoming events</h2><p class="text-secondary mb-0">Find an event that matches your goals.</p></div><a class="btn btn-outline-dark" asp-controller="Events" asp-action="Index">View all events</a></div>
    @if (ViewBag.ApiMessage is string apiMessage) { <div class="alert alert-warning" role="alert">@apiMessage Make sure the Part 2 API is running and the API address is correct in appsettings.json.</div> }
    @if (Model.Length == 0) { <div class="empty-state"><div class="empty-icon">↗</div><h3>No events to show yet</h3><p class="text-secondary">When events are available in the RaceDay API, they will appear here.</p></div> }
    else {
        <div class="row g-4">
        @foreach (var e in Model) {
            var id = Read(e, "eventID"); var name = Read(e, "eventName"); var date = Read(e, "eventDate"); var location = Read(e, "location"); var province = Read(e, "province"); var fee = Read(e, "entryFee"); var status = Read(e, "status");
            <div class="col-md-6 col-xl-4"><article class="event-card h-100"><div class="event-card-top"><span class="event-chip">RACE EVENT</span><span class="status-pill">@(string.IsNullOrWhiteSpace(status) ? "Open" : status)</span><div class="event-number">@(string.IsNullOrWhiteSpace(id) ? "RD" : "#" + id)</div></div><div class="p-4"><h3 class="h5 fw-bold">@(string.IsNullOrWhiteSpace(name) ? "RaceDay event" : name)</h3><p class="text-secondary small mb-3">@(string.Join(", ", new[] { location, province }.Where(x => !string.IsNullOrWhiteSpace(x))))</p><div class="event-meta"><span>◷ @date</span><strong>@(string.IsNullOrWhiteSpace(fee) ? "Fee TBC" : "Entry fee: " + fee)</strong></div><a class="btn btn-dark w-100 mt-4" asp-controller="Events" asp-action="Details" asp-route-id="@id">View event</a></div></article></div>
        }
        </div>
    }
</section>
